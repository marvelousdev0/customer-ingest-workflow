#!/usr/bin/env bash
# Formats staged Java files with Spotless (Google Java Format) and restages them
# so the commit includes the formatting updates.
set -euo pipefail

if [ "${SKIP_SPOTLESS:-}" = "1" ]; then
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

paths=""
rel_files=()
while IFS= read -r -d '' file; do
  if [ -n "$paths" ]; then
    paths="$paths,$root/$file"
  else
    paths="$root/$file"
  fi
  rel_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.java')

if [ ${#rel_files[@]} -eq 0 ]; then
  exit 0
fi

echo "Spotless: formatting ${#rel_files[@]} staged Java file(s)"
if ! ./gradlew spotlessApply -PspotlessIdeHook="$paths" --quiet; then
  echo "Spotless failed. Fix formatting with: ./gradlew spotlessApply" >&2
  exit 1
fi

git add -- "${rel_files[@]}"
