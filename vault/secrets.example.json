{
  "_comment": "HashiCorp Vault KV v2 example payload for secret/data/customer-ingest-workflow. Keys must match Spring property names so Spring Cloud Vault can bind them directly.",
  "data": {
    "spring.kafka.bootstrap-servers": "kafka.broker.example:9092",
    "spring.kafka.properties.schema.registry.url": "https://schema-registry.example",
    "spring.kafka.properties.basic.auth.credentials.source": "USER_INFO",
    "spring.kafka.properties.basic.auth.user.info": "sr-user:sr-password",
    "spring.kafka.properties.security.protocol": "SASL_SSL",
    "spring.kafka.properties.sasl.mechanism": "PLAIN",
    "spring.kafka.properties.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username=\"kafka-user\" password=\"kafka-password\";",
    "spring.data.mongodb.uri": "mongodb://mongo-user:mongo-password@mongodb.example:27017/customer_ingest",
    "spring.data.redis.host": "redis.example",
    "spring.data.redis.port": "6379",
    "spring.data.redis.password": "redis-password",
    "app.kafka.inbound-topic": "customer.ingest.in",
    "app.kafka.outbound-topic": "customer.ingest.out",
    "app.launchdarkly.sdk-key": "sdk-xxxxxxxxxxxxxxxxxxxxxxxx",
    "app.launchdarkly.enabled": "true",
    "app.launchdarkly.offline": "false",
    "management.opentelemetry.tracing.export.otlp.endpoint": "http://otel-collector:4318/v1/traces"
  }
}
