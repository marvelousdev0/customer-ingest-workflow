# Copy to .env (never commit .env). All values are placeholders.

SPRING_APPLICATION_NAME=customer-ingest-workflow
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
VIRTUAL_THREADS_ENABLED=true

# Kafka / Confluent
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_CONSUMER_GROUP=customer-ingest-workflow
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_INBOUND_TOPIC=customer.ingest.in
KAFKA_OUTBOUND_TOPIC=customer.ingest.out
# 2 pods x concurrency 2 = 4 threads for 4 partitions
KAFKA_LISTENER_CONCURRENCY=2
KAFKA_MAX_POLL_RECORDS=25
KAFKA_ISOLATION_LEVEL=read_committed
KAFKA_FETCH_MIN_BYTES=1
KAFKA_FETCH_MAX_WAIT_MS=50
KAFKA_MAX_PARTITION_FETCH_BYTES=1048576
KAFKA_PRODUCER_ACKS=all

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_AUTH_SOURCE=
SCHEMA_REGISTRY_USER_INFO=
SCHEMA_REGISTRY_AUTO_REGISTER=true
SCHEMA_REGISTRY_USE_LATEST=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017/customer_ingest
MONGO_POOL_MIN=10
MONGO_POOL_MAX=50

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_POOL_MAX_ACTIVE=32
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=4
REDIS_LOCK_TTL=10s
REDIS_LOCK_MAX_ATTEMPTS=5
REDIS_LOCK_BACKOFF=25ms
REDIS_DEDUP_TTL=7d

# Tracing (OTLP export is optional; MDC traceId still works in-process)
TRACING_SAMPLE_PROBABILITY=1.0
TRACING_PROPAGATION_CONSUME=W3C,B3
TRACING_PROPAGATION_PRODUCE=W3C,B3
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
